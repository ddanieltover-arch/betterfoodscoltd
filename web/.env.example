# App
NEXT_PUBLIC_URL=https://betterfoodcoltd.com
NEXT_PUBLIC_SITE_NAME="BETTER FOODS CO., LTD"

# ── Database (Supabase Postgres) ───────────────────────────────────
# Transaction pooler (Vercel / serverless) — port 6543
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Session pooler (Prisma migrate / db push) — port 5432
# Prefer db.PROJECT_REF.supabase.co:5432 when your network can reach it.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ── Auth.js ────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=
# Recommended in production (helps secure cookies / host trust)
# AUTH_URL=https://betterfoodcoltd.com
# AUTH_TRUST_HOST=true

# Seed admin (prisma db seed / scripts/set-admin-password.ts)
# Login uses the bcrypt hash in the DB — not this env var at runtime.
ADMIN_EMAIL=sales@betterfoodcoltd.com
ADMIN_PASSWORD=

# Public base for email logo/CTAs (defaults to site URL; avoid localhost)
# NEXT_PUBLIC_EMAIL_ASSET_BASE=https://betterfoodcoltd.com

# ── Resend (REQUIRED) ──────────────────────────────────────────────
# All contact + quote emails are sent ONLY through the Resend SDK.
# Create a key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Sender (domain must be verified in Resend)
RESEND_FROM_EMAIL="Better Foods <sales@betterfoodcoltd.com>"

# Admin inbox (form notifications)
QUOTE_INBOX_EMAIL=sales@betterfoodcoltd.com

# Optional extra admin recipients (comma-separated)
# ADMIN_CC_EMAILS=sale@betterfoodcoltd.com
